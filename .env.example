# Copy to .env and fill in. Never commit .env.
# All auth is via Microsoft Entra ID (DefaultAzureCredential). No API keys.

# Azure AI Foundry project endpoint (used by azure-ai-projects v2)
PROJECT_ENDPOINT=https://r2d2-foundry-001.services.ai.azure.com/api/projects/Main-Project

# Azure OpenAI v1 endpoint (used by the openai SDK)
# Note: pass only the resource portion to AzureOpenAI(azure_endpoint=...). The SDK appends /openai/v1 internally.
AZURE_OPENAI_ENDPOINT=https://r2d2-foundry-001.openai.azure.com

# Model deployment name in your Foundry / Azure OpenAI resource
MODEL_DEPLOYMENT=gpt-5.4

# Reasoning effort for gpt-5.4 (one of: minimal, low, medium, high)
REASONING_EFFORT=low

# Application Insights connection string (used in notebook #7 for Agent 365 OTel traces)
# Resource: aq-app-insights-001 in RG AQ-FOUNDRY-RG
APPLICATIONINSIGHTS_CONNECTION_STRING=InstrumentationKey=dbe91837-535a-4b6d-864a-9afe2f763470;IngestionEndpoint=https://eastus2-3.in.applicationinsights.azure.com/;LiveEndpoint=https://eastus2.livediagnostics.monitor.azure.com/;ApplicationId=198f0a43-f1a5-4a49-bda5-41c925456771
